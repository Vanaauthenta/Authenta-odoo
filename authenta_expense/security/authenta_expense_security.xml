<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Mirrors hr_expense's own expense rules, applied through the verification's expense -->
        <record id="ir_rule_authenta_verification_employee" model="ir.rule">
            <field name="name">Authenta Verification: own expenses</field>
            <field name="model_id" ref="model_authenta_verification"/>
            <field name="domain_force">[('expense_id.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="ir_rule_authenta_verification_team_approver" model="ir.rule">
            <field name="name">Authenta Verification: team approver</field>
            <field name="model_id" ref="model_authenta_verification"/>
            <field name="domain_force">['|', '|', '|', '|',
                ('expense_id.employee_id.user_id', '=', user.id),
                ('expense_id.employee_id.department_id.manager_id.user_id', '=', user.id),
                ('expense_id.employee_id.parent_id.user_id', '=', user.id),
                ('expense_id.employee_id.expense_manager_id', '=', user.id),
                ('expense_id.sheet_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_expense.group_hr_expense_team_approver'))]"/>
        </record>

        <record id="ir_rule_authenta_verification_all" model="ir.rule">
            <field name="name">Authenta Verification: all approvers</field>
            <field name="model_id" ref="model_authenta_verification"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_expense.group_hr_expense_user'))]"/>
        </record>

        <record id="ir_rule_authenta_verification_company" model="ir.rule">
            <field name="name">Authenta Verification: multi-company</field>
            <field name="model_id" ref="model_authenta_verification"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
